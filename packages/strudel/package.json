{
  "name": "@av/strudel",
  "version": "0.1.0",
  "description": "Music written as Strudel code, checked and rendered to audio offline: the pinned Strudel engine in a headless Chrome, parts soloed or muted, any stretch of cycles, seamless loops, and measurements of what was made",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./session": {
      "types": "./dist/page/session.d.ts",
      "import": "./dist/page/session.js"
    }
  },
  "bin": {
    "strudel-render": "./dist/cli.js"
  },
  "files": [
    "dist/**"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@strudel/web": "1.3.0",
    "playwright-core": "^1.55.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "AGPL-3.0-or-later",
  "private": true
}
