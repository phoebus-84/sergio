{
  "description": "A clip with Wan 2.2 TI2V 5B: from a prompt alone, or from a first frame and a prompt. 1280×704 at 24 fps by default; length is in frames, 4n+1 (121 is five seconds). Core nodes only.",
  "kind": "video",
  "inputs": {
    "prompt": { "type": "text", "description": "What happens: the subject, its motion, the camera" },
    "negativePrompt": { "type": "text", "default": "blurry, low quality, still image, static, frozen, subtitles, text, watermark, logo, jpeg artifacts, deformed, extra fingers, poorly drawn hands, poorly drawn face, distorted limbs, cluttered background", "description": "What to avoid" },
    "image": { "type": "image", "optional": true, "description": "The first frame; without it the clip is made from the prompt alone" },
    "width": { "type": "integer", "default": 1280, "min": 256, "max": 1280, "description": "Pixels, a multiple of 32" },
    "height": { "type": "integer", "default": 704, "min": 256, "max": 1280, "description": "Pixels, a multiple of 32" },
    "length": { "type": "integer", "default": 121, "min": 5, "max": 241, "description": "Frames, 4n+1" },
    "fps": { "type": "integer", "default": 24, "min": 8, "max": 60 },
    "steps": { "type": "integer", "default": 20, "min": 1, "max": 60 },
    "cfg": { "type": "number", "default": 5, "min": 1, "max": 15 },
    "seed": { "type": "seed" },
    "unetModel": { "type": "model", "default": "wan2.2_ti2v_5B_fp16.safetensors", "description": "Wan 2.2 TI2V 5B, as this server names it" },
    "textEncoder": { "type": "model", "default": "umt5_xxl_fp16.safetensors", "description": "UMT5-XXL text encoder (fp16, or umt5_xxl_fp8_e4m3fn_scaled.safetensors)" },
    "vae": { "type": "model", "default": "wan2.2_vae.safetensors", "description": "The Wan 2.2 autoencoder (not Wan 2.1's)" }
  },
  "outputs": { "58": "video" },
  "verifiedOn": "ComfyUI 0.45.0, RX 7900 XTX (ROCm), 2026-11-20",
  "optionalNodes": { "image": "56" },
  "requires": {
    "models": [
      { "node": "37", "input": "unet_name", "folder": "diffusion_models", "source": "Hugging Face Comfy-Org/Wan_2.2_ComfyUI_Repackaged" },
      { "node": "38", "input": "clip_name", "folder": "text_encoders", "source": "Hugging Face Comfy-Org/Wan_2.1_ComfyUI_repackaged" },
      { "node": "39", "input": "vae_name", "folder": "vae", "source": "Hugging Face Comfy-Org/Wan_2.2_ComfyUI_Repackaged" }
    ]
  },
  "prompt": {
    "37": { "class_type": "UNETLoader", "inputs": { "unet_name": "{{unetModel}}", "weight_dtype": "default" } },
    "38": { "class_type": "CLIPLoader", "inputs": { "clip_name": "{{textEncoder}}", "type": "wan", "device": "default" } },
    "39": { "class_type": "VAELoader", "inputs": { "vae_name": "{{vae}}" } },
    "48": { "class_type": "ModelSamplingSD3", "inputs": { "model": ["37", 0], "shift": 8 } },
    "6": { "class_type": "CLIPTextEncode", "inputs": { "clip": ["38", 0], "text": "{{prompt}}" } },
    "7": { "class_type": "CLIPTextEncode", "inputs": { "clip": ["38", 0], "text": "{{negativePrompt}}" } },
    "56": { "class_type": "LoadImage", "inputs": { "image": "{{image}}" } },
    "55": {
      "class_type": "Wan22ImageToVideoLatent",
      "inputs": { "vae": ["39", 0], "width": "{{width}}", "height": "{{height}}", "length": "{{length}}", "batch_size": 1, "start_image": ["56", 0] }
    },
    "3": {
      "class_type": "KSampler",
      "inputs": {
        "model": ["48", 0], "positive": ["6", 0], "negative": ["7", 0], "latent_image": ["55", 0],
        "seed": "{{seed}}", "steps": "{{steps}}", "cfg": "{{cfg}}", "sampler_name": "uni_pc", "scheduler": "simple", "denoise": 1
      }
    },
    "8": { "class_type": "VAEDecode", "inputs": { "samples": ["3", 0], "vae": ["39", 0] } },
    "57": { "class_type": "CreateVideo", "inputs": { "images": ["8", 0], "fps": "{{fps}}" } },
    "58": { "class_type": "SaveVideo", "inputs": { "video": ["57", 0], "filename_prefix": "{{outputPrefix}}", "format": "auto", "codec": "auto" } }
  }
}
