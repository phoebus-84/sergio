{
  "name": "@av/worldlabs-atlas",
  "version": "0.1.0",
  "description": "World Labs Atlas API client: pictures of a place to a Gaussian splat, a splat to a mesh, views along a camera path. Tracked operations, provenance and cost.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/**"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "cli": "node --import tsx src/cli.ts",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "tsx": "^4.23.1",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "Apache-2.0",
  "private": true
}
