{
  "description": "Clean a reference, then clone it: cut the part to learn from, separate the voice from music and noise (Hybrid Demucs, the Vocals output), learn the voice from the cleaned part, optionally save it on the server under a name, and say a new sentence with it. The cleaned reference is saved too, to be listened to.",
  "outputs": { "speech": "8", "cleanedReference": "4" },
  "optionalNodes": { "saveVoiceAs": "6" },
  "prompt": {
    "1": {
      "class_type": "LoadAudio",
      "inputs": { "audio": "{{referenceAudio}}" }
    },
    "2": {
      "class_type": "TrimAudioDuration",
      "inputs": { "audio": ["1", 0], "start_index": "{{referenceStart}}", "duration": "{{referenceDuration}}" }
    },
    "3": {
      "class_type": "AudioSeparation",
      "inputs": { "audio": ["2", 0], "chunk_fade_shape": "linear", "chunk_length": 10.0, "chunk_overlap": 0.1 }
    },
    "4": {
      "class_type": "SaveAudio",
      "inputs": { "audio": ["3", 3], "filename_prefix": "{{cleanedPrefix}}" }
    },
    "5": {
      "class_type": "FB_Qwen3TTSVoiceClonePrompt",
      "inputs": {
        "ref_audio": ["3", 3],
        "ref_text": "{{referenceText}}",
        "model_choice": "{{model}}",
        "device": "{{device}}",
        "precision": "{{precision}}",
        "attention": "{{attention}}",
        "x_vector_only": "{{timbreOnly}}",
        "unload_model_after_generate": false
      }
    },
    "6": {
      "class_type": "FB_Qwen3TTSSaveVoice",
      "inputs": { "voice_clone_prompt": ["5", 0], "filename": "{{saveVoiceAs}}", "audio": ["3", 3], "ref_text": "{{referenceText}}" }
    },
    "7": {
      "class_type": "FB_Qwen3TTSVoiceClone",
      "inputs": {
        "target_text": "{{text}}",
        "model_choice": "{{model}}",
        "device": "{{device}}",
        "precision": "{{precision}}",
        "language": "{{language}}",
        "voice_clone_prompt": ["5", 0],
        "seed": "{{seed}}",
        "x_vector_only": "{{timbreOnly}}",
        "temperature": "{{temperature}}",
        "repetition_penalty": "{{repetitionPenalty}}",
        "attention": "{{attention}}",
        "unload_model_after_generate": "{{unloadModel}}"
      }
    },
    "8": {
      "class_type": "SaveAudio",
      "inputs": { "audio": ["7", 0], "filename_prefix": "{{outputPrefix}}" }
    }
  }
}
