// A warm, light, positive underscore for an explainer: plucks on the chord tones, pad, bass, light drums, bells in B.
// C major, 110 bpm. Its last chord lands on bar 20 and rings.
// render: cycles 24, tail 3 = 55.36 s
setcpm(110/4)
const form = "<i@4 a@8 b@8 o@4>"                      // intro | A | B | outro(last chord rings)
const inSec = (names) => form.fmap((x) => names.split(' ').includes(x))
const prog = "<C G Am F>"                              // I V vi IV, one chord per bar

pluck: n("0 2 1 2 0 2 1 3").chord(prog).anchor("c5").voicing()     // muted-guitar-like 8th-note pattern on the chord tones
         .s("sawtooth").lpf(1200).lpenv(2.5).lpdecay(.09).decay(.16).sustain(0).release(.05)
         .delay(.25).delaytime(60/110*.75).delayfeedback(.3)
         .gain("[.9 .6]*4").pan(.4)
         .mask(inSec('i a b'))
pad:   chord(prog).anchor("g4").voicing().s("sawtooth").lpf(900).attack(.4).release(.8)
         .room(.35).rsize(3).gain(.13)
         .mask(inSec('i a b'))
bass:  prog.rootNotes(2).note().struct("x ~ ~ x ~ ~ x ~").s("triangle").lpf(500).lpenv(1.5).lpdecay(.15)
         .decay(.3).sustain(.4).release(.08).gain(.7)
         .mask(inSec('a b'))
kick:  s("sbd*4").decay(.22).gain(.5).mask(inSec('a b'))
hats:  s("white*8").hpf(8000).decay(.03).gain("[.7 .4]*4").pan(.6).mask(inSec('a b'))
clap:  s("white").struct("~ x ~ x").bpf(1500).bpq(1).decay(.09).gain(1).room(.2).mask(inSec('b'))
bells: n("<[4 ~ ~ 2] [~ 4 ~ ~] [2 ~ 4 5] [4 ~ ~ ~]>").scale("C5:major")
         .s("sine").fm(1.5).fmh(3).fmdecay(.3).decay(.6).sustain(0).release(.4)
         .room(.4).gain(.5).pan(.55)
         .mask(inSec('b'))
end:   chord("C").anchor("c5").voicing().s("sawtooth").lpf(1500).attack(.01).decay(3).sustain(0).release(2)
         .room(.5).rsize(3).gain(.3)
         .mask("<0!20 1 0!3>")                         // one final chord on bar 20, rings out
endb:  note("c2").s("triangle").lpf(500).decay(3).sustain(0).release(1).gain(.6).mask("<0!20 1 0!3>")
all(x => x.postgain(.7))                               // master trim: -3 dB on every part (headroom)
