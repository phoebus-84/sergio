// Sixty seconds with a shape: intro (0-8 s), build (8-24 s), peak (24-40 s), outro (40-52 s), a final chord (52 s)
// that rings to 60.0 s. F major, 120 bpm.
// render: cycles 28, tail 4 = 60 s
setcpm(120/4)                                          // 1 bar = 2 s
const letters = ['i', 'b', 'p', 'o', 'e']
const form = "<i@4 b@8 p@8 o@6 e@2>"                   // intro 0-8 s | build 8-24 s | peak 24-40 s | outro 40-52 s | final chord 52 s
const inSec = (names) => form.fmap((x) => names.split(' ').includes(x))
const only = (table) => form.pickRestart(Object.assign(Object.fromEntries(letters.map((l) => [l, silence])), table))
const sect = (table) => form.pickRestart(table)        // per-section VALUES or signals, restarted at each section start
const prog = "<F C Dm Bb>"                              // I V vi IV in F major, one chord per bar

pad:   chord(prog).anchor("a4").voicing().s("sawtooth")
         .lpf(sect({ i: 500, b: saw.rangex(500, 2200).slow(8), p: 2400, o: isaw.rangex(600, 2400).slow(6), e: 600 }))
         .attack(.3).release(.8).room(.4).rsize(3).gain(.16)
         .mask(inSec('i b p o'))
pluck: n("0 2 1 2 0 2 1 3").chord(prog).anchor("c5").voicing()
         .s("sawtooth").lpf(1200).lpenv(2.5).lpdecay(.09).decay(.16).sustain(0).release(.05)
         .delay(.25).delaytime(60/120*.75).delayfeedback(.3)
         .gain("[.9 .6]*4").pan(.42)
         .mask(inSec('i b p o'))
bass:  only({ b: prog.rootNotes(2).note().struct("x ~ ~ ~ x ~ ~ ~"),       // build: two notes per bar
              p: prog.rootNotes(2).note().struct("x x x x x x x x"),       // peak: driving 8ths
              o: prog.rootNotes(2).note() })                               // outro: one long note per bar
         .s("triangle").lpf(500).lpenv(1.5).lpdecay(.15).decay(.3).sustain(.5).release(.08).gain(.75)
kick:  only({ b: s("sbd ~ sbd ~"), p: s("sbd*4") }).decay(.25).gain(.5)   // half-time in the build, four-on-the-floor at the peak
clap:  only({ p: s("white").struct("~ x ~ x") }).bpf(1500).bpq(1).decay(.1).room(.2).gain(1.1)
roll:  only({ b: s("white*16").mask("<0!7 1>")         // snare roll in the last bar of the build, getting louder
              .gain(saw.range(.4, 1.8).late(7)) }).bpf(1800).bpq(1).decay(.05)
hats:  only({ b: s("white*4"), p: s("white*8") }).hpf(8000).decay(.03).gain("[.7 .4]*4").pan(.6)
lead:  only({ p: n("<[4 ~ 4 5] [4 ~ 2 ~] [0 ~ 2 4] [5 4 2 ~]>") })   // 4-bar melody, played twice in the peak
         .scale("F5:major").s("triangle").lpf(3500).attack(.01).decay(.3).sustain(.4).release(.2)
         .delay(.3).delaytime(60/120*.75).delayfeedback(.3).room(.3).gain(.75).pan(.55)
riser: only({ b: s("white").slow(2).mask("<0!6 1!2>")  // only the 2-bar event that starts at bar 6 of the section
              .lpf(300).lpenv(5.5).lpattack(3.9).attack(3.9).release(.05).gain(.4) })
crash: only({ p: s("white").hpf(4000).decay(1.5).sustain(0).mask("<1 0!7>") }).room(.4).gain(.4)
end:   only({ e: stack(                                // final chord (2 bars), rings into the tail
         chord("F").anchor("c5").voicing().slow(2).s("sawtooth").lpf(1500).attack(.01).decay(3.5).sustain(0).release(2).gain(.3),
         note("f2").slow(2).s("triangle").lpf(500).decay(3.5).sustain(0).release(1.5).gain(.6),
         n("[4,7]").scale("F5:major").slow(2).s("sine").fm(2).fmh(3.5).fmdecay(.8).decay(3).sustain(0).release(2).gain(.2)
       ).room(.5).rsize(3) })
// master: section dynamics (postgain multiplies every part)
all(x => x.postgain(sect({ i: .5, b: saw.range(.5, .66).slow(8), p: .7, o: isaw.range(.38, .58).slow(6), e: .6 })))
