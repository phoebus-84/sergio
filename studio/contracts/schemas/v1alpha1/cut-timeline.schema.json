{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.studio.video/v1alpha1/cut-timeline.schema.json",
  "title": "Sergio cut timeline (ADR-0050)",
  "description": "The editable account of how a production unit is cut: clips of picture and sound placed on tracks, trimmed, retimed, joined by transitions, treated by effects, mixed and mastered. A person or the agent edits it; FFmpeg renders it. Positions and lengths on the timeline are integer frames at format.fps; positions inside a source are seconds; gains are dB. Rules a schema cannot express (overlaps, references) are checked by validateCutTimeline in src/cut-timeline.mjs.",
  "$defs": {
    "LocalId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$", "maxLength": 80 },
    "Slug": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "Frame": { "type": "integer", "minimum": 0 },
    "FrameCount": { "type": "integer", "minimum": 1 },
    "RelativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*//)[^\\u0000-\\u001F\\u007F]+$"
    },
    "UnitRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channel", "series", "episode"],
      "properties": {
        "channel": { "type": "string", "minLength": 1 },
        "series": { "type": "string", "minLength": 1 },
        "episode": { "type": "string", "minLength": 1 }
      }
    },
    "Format": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "fps"],
      "properties": {
        "id": { "$ref": "#/$defs/Slug" },
        "width": { "type": "integer", "minimum": 16, "maximum": 7680, "multipleOf": 2 },
        "height": { "type": "integer", "minimum": 16, "maximum": 4320, "multipleOf": 2 },
        "fps": { "type": "integer", "enum": [24, 25, 30, 48, 50, 60] }
      }
    },
    "Source": {
      "type": "object",
      "additionalProperties": false,
      "description": "Where a clip's media comes from, exactly one of: a child unit's current render (a shot of this scene, a scene of this film); a file of this unit; a file of the project (footage/, music/); a solid colour.",
      "properties": {
        "unit": { "$ref": "#/$defs/Slug" },
        "path": { "$ref": "#/$defs/RelativePath" },
        "project": { "$ref": "#/$defs/RelativePath" },
        "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" }
      }
    },
    "Effect": {
      "type": "object",
      "additionalProperties": false,
      "description": "One treatment of picture or sound, by its name in the renderer's catalog. Its parameters are checked against that catalog when the cut is checked or rendered.",
      "required": ["type"],
      "properties": {
        "type": { "type": "string", "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$" },
        "params": {
          "type": "object",
          "additionalProperties": { "anyOf": [{ "type": "number" }, { "type": "string" }, { "type": "boolean" }] }
        },
        "enabled": { "type": "boolean" }
      }
    },
    "Transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "duration"],
      "properties": {
        "type": { "type": "string", "enum": ["dissolve", "fade", "wipe-left", "wipe-right", "wipe-up", "wipe-down"] },
        "duration": { "$ref": "#/$defs/FrameCount" }
      }
    },
    "ClipAudio": {
      "type": "object",
      "additionalProperties": false,
      "description": "The sound a picture clip carries.",
      "properties": {
        "mute": { "type": "boolean" },
        "gain": { "type": "number", "minimum": -96, "maximum": 24 },
        "fadeIn": { "$ref": "#/$defs/Frame" },
        "fadeOut": { "$ref": "#/$defs/Frame" },
        "effects": { "type": "array", "items": { "$ref": "#/$defs/Effect" } }
      }
    },
    "Clip": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source", "at", "duration"],
      "properties": {
        "id": { "$ref": "#/$defs/LocalId" },
        "label": { "type": "string", "maxLength": 160 },
        "source": { "$ref": "#/$defs/Source" },
        "at": { "$ref": "#/$defs/Frame" },
        "duration": { "$ref": "#/$defs/FrameCount" },
        "in": { "type": "number", "minimum": 0, "description": "Where the clip starts in its source, seconds." },
        "speed": { "type": "number", "minimum": 0.1, "maximum": 10 },
        "fit": { "type": "string", "enum": ["cover", "contain", "fill"] },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
        "transitionIn": { "$ref": "#/$defs/Transition" },
        "transitionOut": { "$ref": "#/$defs/Transition" },
        "effects": { "type": "array", "items": { "$ref": "#/$defs/Effect" } },
        "audio": { "$ref": "#/$defs/ClipAudio" },
        "gain": { "type": "number", "minimum": -96, "maximum": 24 },
        "fadeIn": { "$ref": "#/$defs/Frame" },
        "fadeOut": { "$ref": "#/$defs/Frame" },
        "locked": { "type": "boolean", "description": "A person fixed this clip: the agent leaves it as it is." },
        "note": { "type": "string", "maxLength": 2000 }
      }
    },
    "Duck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["under", "gain"],
      "properties": {
        "under": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/LocalId" } },
        "gain": { "type": "number", "minimum": -60, "maximum": 0 },
        "attack": { "type": "number", "minimum": 0, "maximum": 10 },
        "release": { "type": "number", "minimum": 0, "maximum": 10 }
      }
    },
    "Track": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "clips"],
      "properties": {
        "id": { "$ref": "#/$defs/LocalId" },
        "kind": { "type": "string", "enum": ["video", "audio"] },
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "role": { "type": "string", "enum": ["picture", "overlay", "dialogue", "music", "effects", "ambience"] },
        "muted": { "type": "boolean" },
        "locked": { "type": "boolean" },
        "gain": { "type": "number", "minimum": -96, "maximum": 24 },
        "duck": { "$ref": "#/$defs/Duck" },
        "effects": { "type": "array", "items": { "$ref": "#/$defs/Effect" } },
        "clips": { "type": "array", "items": { "$ref": "#/$defs/Clip" } }
      }
    },
    "Marker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "at"],
      "properties": {
        "id": { "$ref": "#/$defs/LocalId" },
        "at": { "$ref": "#/$defs/Frame" },
        "label": { "type": "string", "maxLength": 160 },
        "note": { "type": "string", "maxLength": 2000 }
      }
    },
    "Master": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "video": { "type": "array", "items": { "$ref": "#/$defs/Effect" } },
        "audio": { "type": "array", "items": { "$ref": "#/$defs/Effect" } },
        "loudness": {
          "type": "object",
          "additionalProperties": false,
          "required": ["integrated", "truePeak"],
          "properties": {
            "integrated": { "type": "number", "minimum": -70, "maximum": -5 },
            "truePeak": { "type": "number", "minimum": -9, "maximum": 0 },
            "range": { "type": "number", "minimum": 1, "maximum": 30 }
          }
        }
      }
    },
    "CutTimeline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiVersion", "kind", "unit", "revision", "format", "tracks"],
      "properties": {
        "apiVersion": { "type": "string", "const": "studio.video/v1alpha1" },
        "kind": { "type": "string", "const": "CutTimeline" },
        "unit": { "$ref": "#/$defs/UnitRef" },
        "revision": { "type": "integer", "minimum": 1 },
        "format": { "$ref": "#/$defs/Format" },
        "tracks": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/Track" } },
        "markers": { "type": "array", "items": { "$ref": "#/$defs/Marker" } },
        "master": { "$ref": "#/$defs/Master" },
        "metadata": { "type": "object", "additionalProperties": true }
      }
    }
  }
}
